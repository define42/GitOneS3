diff --git a/cmd/object-handlers-conditional-delete_test.go b/cmd/object-handlers-conditional-delete_test.go
new file mode 100644
index 0000000..7226706
--- /dev/null
+++ b/cmd/object-handlers-conditional-delete_test.go
@@ -0,0 +1,97 @@
+// Copyright (c) 2026 GitOne contributors.
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package cmd
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/minio/minio/internal/auth"
+	xhttp "github.com/minio/minio/internal/http"
+)
+
+func TestAPIDeleteObjectIfMatch(t *testing.T) {
+	defer DetectTestLeak(t)()
+	ExecObjectLayerAPITest(ExecObjectLayerAPITestArgs{
+		t: t, endpoints: []string{"DeleteObject"}, objAPITest: testAPIDeleteObjectIfMatch,
+	})
+}
+
+func testAPIDeleteObjectIfMatch(obj ObjectLayer, instanceType, bucket string, router http.Handler, credentials auth.Credentials, t *testing.T) {
+	ctx := context.Background()
+	put := func(t *testing.T, key, body string) ObjectInfo {
+		t.Helper()
+		info, err := obj.PutObject(ctx, bucket, key,
+			mustGetPutObjReader(t, bytes.NewReader([]byte(body)), int64(len(body)), "", ""), ObjectOptions{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return info
+	}
+	remove := func(t *testing.T, key, match string, extra map[string]string, want int) {
+		t.Helper()
+		headers := make(map[string]string)
+		if match != "" {
+			headers[xhttp.IfMatch] = match
+		}
+		for key, value := range extra {
+			headers[key] = value
+		}
+		req, err := newTestSignedRequestV4(http.MethodDelete, getDeleteObjectURL("", bucket, key),
+			0, nil, credentials.AccessKey, credentials.SecretKey, headers)
+		if err != nil {
+			t.Fatal(err)
+		}
+		rec := httptest.NewRecorder()
+		router.ServeHTTP(rec, req)
+		if rec.Code != want {
+			t.Fatalf("%s DELETE %q If-Match %q: status %d, want %d: %s", instanceType, key, match, rec.Code, want, rec.Body.String())
+		}
+	}
+	assertBody := func(t *testing.T, key, want string) {
+		t.Helper()
+		reader, err := obj.GetObjectNInfo(ctx, bucket, key, nil, nil, ObjectOptions{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer reader.Close()
+		body, err := io.ReadAll(reader)
+		if err != nil || string(body) != want {
+			t.Fatalf("%s GET %q: body %q, error %v, want %q", instanceType, key, body, err, want)
+		}
+	}
+	t.Run("wrong and stale ETags preserve replacement", func(t *testing.T) {
+		const key = "conditional-delete-stale"
+		first := put(t, key, "first body")
+		remove(t, key, `"wrong"`, nil, http.StatusPreconditionFailed)
+		assertBody(t, key, "first body")
+		second := put(t, key, "replacement body")
+		remove(t, key, `"`+first.ETag+`"`, nil, http.StatusPreconditionFailed)
+		assertBody(t, key, "replacement body")
+		remove(t, key, `W/"`+second.ETag+`"`, nil, http.StatusPreconditionFailed)
+		assertBody(t, key, "replacement body")
+		remove(t, key, `"`+second.ETag+`"`, nil, http.StatusNoContent)
+		if _, err := obj.GetObjectInfo(ctx, bucket, key, ObjectOptions{}); !isErrObjectNotFound(err) {
+			t.Fatalf("deleted object still present: %v", err)
+		}
+	})
+	t.Run("missing key and wildcard", func(t *testing.T) {
+		const key = "conditional-delete-wildcard"
+		remove(t, key, `"missing"`, nil, http.StatusPreconditionFailed)
+		remove(t, key, "*", nil, http.StatusPreconditionFailed)
+		put(t, key, "wildcard body")
+		remove(t, key, "*", nil, http.StatusNoContent)
+		remove(t, key, "", nil, http.StatusNoContent)
+	})
+	t.Run("conditional prefix deletion rejected", func(t *testing.T) {
+		const key = "conditional-prefix/object"
+		put(t, key, "keep this body")
+		remove(t, "conditional-prefix/", "*", map[string]string{xhttp.MinIOForceDelete: "true"}, http.StatusBadRequest)
+		assertBody(t, key, "keep this body")
+	})
+}
