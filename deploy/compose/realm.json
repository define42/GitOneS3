{
  "realm": "gitone",
  "enabled": true,
  "registrationAllowed": false,
  "sslRequired": "all",
  "clients": [{
    "clientId": "gitone",
    "enabled": true,
    "protocol": "openid-connect",
    "publicClient": false,
    "clientAuthenticatorType": "client-secret",
    "standardFlowEnabled": true,
    "implicitFlowEnabled": false,
    "directAccessGrantsEnabled": false,
    "serviceAccountsEnabled": false,
    "redirectUris": ["https://gitone.localhost:8443/auth/oidc/callback"],
    "webOrigins": ["https://gitone.localhost:8443"],
    "defaultClientScopes": ["profile", "email"],
    "attributes": {"pkce.code.challenge.method": "S256"}
  }],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.test",
      "firstName": "Alice",
      "lastName": "Example",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{"type": "password", "value": "alice-dev-password", "temporary": false}]
    },
    {
      "username": "bob",
      "email": "bob@example.test",
      "firstName": "Bob",
      "lastName": "Example",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{"type": "password", "value": "bob-dev-password", "temporary": false}]
    }
  ]
}
